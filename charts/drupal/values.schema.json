{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "drupal",
    "redis",
    "database",
    "verticalPodAutoscaler"
  ],
  "properties": {
    "nameOverride": {
      "type": "string",
      "title": "Anwendungslabel überschreiben",
      "description": "Optionales app.kubernetes.io/name-Label. Ressourcennamen werden weiterhin aus dem Helm-Release abgeleitet.",
      "default": ""
    },
    "platform": {
      "type": "object",
      "title": "Zielplattform",
      "description": "Wählt OpenShift Route und ImageStreams oder ein Kubernetes Ingress.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Plattform",
          "description": "Für die Installation aus dem OpenShift Developer Catalog openshift verwenden.",
          "enum": ["openshift", "kubernetes"],
          "default": "openshift"
        }
      }
    },
    "naming": {
      "type": "object",
      "title": "Release-Namen",
      "description": "Schutz vor Installationen unter einem falschen Release- oder Namespace-Namen.",
      "additionalProperties": false,
      "properties": {
        "enforceReleaseNamespaceMatch": {
          "type": "boolean",
          "title": "Release und Namespace müssen übereinstimmen",
          "default": false
        },
        "allowedReleaseNames": {
          "type": "array",
          "title": "Erlaubte Release-Namen",
          "description": "Leer erlaubt beliebige Namen. Website-Profile begrenzen die Auswahl auf ihren vorgesehenen Release-Namen.",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 53
          }
        }
      }
    },
    "commonAnnotations": {
      "$ref": "#/definitions/annotations"
    },
    "protection": {
      "type": "object",
      "title": "Schutz vorhandener Ressourcen",
      "description": "Verhindert, dass gleichnamige fremde Kubernetes-Ressourcen versehentlich übernommen werden.",
      "additionalProperties": false,
      "properties": {
        "failOnExistingResource": {
          "type": "boolean",
          "title": "Bei fremden Ressourcen abbrechen",
          "default": true
        }
      }
    },
    "verticalPodAutoscaler": {
      "type": "object",
      "title": "Vertical Pod Autoscaler",
      "description": "Benötigt einen installierten VPA-Operator und dessen CRD. Der Modus Off sammelt nur Empfehlungen.",
      "additionalProperties": false,
      "required": ["enabled", "updateMode"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "VPA-Ressourcen erzeugen",
          "default": false
        },
        "updateMode": {
          "type": "string",
          "title": "Update-Modus",
          "enum": ["Off", "Initial", "Recreate", "InPlaceOrRecreate", "InPlace", "Auto"],
          "default": "Off"
        },
        "controlledResources": {
          "type": "array",
          "title": "Gesteuerte Ressourcen",
          "default": ["cpu", "memory"],
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["cpu", "memory"]
          }
        },
        "controlledValues": {
          "type": "string",
          "title": "Gesteuerte Werte",
          "enum": ["RequestsAndLimits", "RequestsOnly"],
          "default": "RequestsAndLimits"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "title": "Registry-Zugangsdaten",
      "description": "Bereits vorhandene Image-Pull-Secrets für alle Pods.",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "title": "Secret-Name",
            "minLength": 1
          }
        }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "title": "Service Accounts",
      "description": "Erzeugt getrennte Service Accounts für Drupal, Redis und MariaDB oder verwendet vorhandene Namen.",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "title": "Service Accounts erzeugen",
          "default": true
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "drupalName": {
          "type": "string",
          "title": "Vorhandener Drupal Service Account",
          "default": ""
        },
        "redisName": {
          "type": "string",
          "title": "Vorhandener Redis Service Account",
          "default": ""
        },
        "databaseName": {
          "type": "string",
          "title": "Vorhandener MariaDB Service Account",
          "default": ""
        }
      }
    },
    "drupal": {
      "type": "object",
      "title": "Drupal-Anwendung",
      "description": "Öffentlicher Host, Containerimage, Drupal-Konfiguration, Persistenz und Laufzeitressourcen.",
      "additionalProperties": false,
      "required": ["externalHost", "image", "persistence"],
      "properties": {
        "externalHost": {
          "type": "string",
          "title": "Öffentlicher DNS-Hostname",
          "description": "Pflichtfeld für die OpenShift Route beziehungsweise das Kubernetes Ingress und Drupals Trusted-Host-Regel. change-me.example.invalid ist nur ein nicht auflösbarer Platzhalter und muss ersetzt werden.",
          "default": "change-me.example.invalid",
          "minLength": 4,
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "replicaCount": {
          "type": "integer",
          "title": "Drupal-Replikate",
          "description": "Mehr als eine Replik erfordert ein ReadWriteMany-fähiges Drupal-Volume.",
          "default": 1,
          "minimum": 1
        },
        "image": {
          "type": "object",
          "title": "Drupal-Image",
          "description": "DDBgo-/DDBpro-kompatibles Anwendungsimage gemäß dem dokumentierten Containervertrag.",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "title": "Image-Repository",
              "default": "ghcr.io/mbuechner/ddbgo",
              "minLength": 1,
              "pattern": "^[^\\s]+$"
            },
            "tag": {
              "type": "string",
              "title": "Image-Tag",
              "default": "tagged",
              "minLength": 1,
              "pattern": "^[^\\s]+$"
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            },
            "autoUpdate": {
              "$ref": "#/definitions/autoUpdate"
            }
          }
        },
        "service": {
          "type": "object",
          "title": "Drupal-Service",
          "description": "Interner HTTP-Service für Route oder Ingress.",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "title": "Service-Port",
              "default": 8080,
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "route": {
          "type": "object",
          "title": "OpenShift Route",
          "description": "Wird nur auf OpenShift ausgewertet. TLS endet gemäß Betriebsmodell vor der Route.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Route erzeugen",
              "default": true
            },
            "annotations": {
              "$ref": "#/definitions/annotations"
            }
          }
        },
        "ingress": {
          "type": "object",
          "title": "Kubernetes Ingress",
          "description": "Wird nur mit platform.type=kubernetes ausgewertet.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Ingress erzeugen",
              "default": true
            },
            "className": {
              "type": "string",
              "title": "IngressClass",
              "default": ""
            },
            "annotations": {
              "$ref": "#/definitions/annotations"
            },
            "path": {
              "type": "string",
              "title": "Ingress-Pfad",
              "default": "/",
              "pattern": "^/"
            },
            "pathType": {
              "type": "string",
              "title": "Ingress-Pfadtyp",
              "enum": ["Exact", "Prefix", "ImplementationSpecific"],
              "default": "Prefix"
            }
          }
        },
        "config": {
          "type": "object",
          "title": "Drupal-Konfiguration",
          "description": "Pfade, Trusted Hosts und lokaler Drush-Kontext des kompatiblen Drupal-Images.",
          "additionalProperties": false,
          "properties": {
            "webRoot": {
              "type": "string",
              "title": "Drupal-Webroot",
              "default": "/var/www/html/web",
              "pattern": "^/"
            },
            "updateFreeAccess": {
              "type": "boolean",
              "title": "Freien Zugriff auf update.php erlauben",
              "default": false
            },
            "filePublicPath": {
              "type": "string",
              "title": "Öffentlicher Dateipfad",
              "description": "Relativ zum Drupal-Webroot und ohne .- oder ..-Segmente.",
              "default": "sites/default/files",
              "minLength": 1,
              "pattern": "^[^/].*$"
            },
            "filePrivatePath": {
              "type": "string",
              "title": "Privater Dateipfad",
              "default": "/var/www/html/private",
              "pattern": "^/"
            },
            "tempPath": {
              "type": "string",
              "title": "Temporärer Pfad",
              "default": "/tmp",
              "pattern": "^/"
            },
            "trustedHosts": {
              "type": "object",
              "title": "Zusätzliche Trusted Hosts",
              "description": "Literale Hostnamen; das Chart maskiert sie automatisch für Drupals reguläre Ausdrücke.",
              "additionalProperties": false,
              "properties": {
                "allowLocalhost": {
                  "type": "boolean",
                  "title": "localhost erlauben",
                  "default": true
                },
                "additionalHosts": {
                  "type": "array",
                  "title": "Weitere Hostnamen",
                  "default": [],
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "drushOptionsUri": {
              "type": "string",
              "title": "Lokale Drush-URI",
              "default": "http://localhost:8080",
              "pattern": "^https?://"
            }
          }
        },
        "env": {
          "type": "object",
          "title": "Drupal-Startaktionen und Basic Auth",
          "description": "Steuert zustandsändernde Drush-Aktionen beim Containerstart sowie optionale HTTP-Basic-Auth-Werte.",
          "additionalProperties": false,
          "properties": {
            "UPDATEDB_ON_STARTUP": {
              "$ref": "#/definitions/yesNo"
            },
            "CONFIG_IMPORT_ON_STARTUP": {
              "$ref": "#/definitions/yesNo"
            },
            "CACHEREBUILD_ON_STARTUP": {
              "$ref": "#/definitions/yesNo"
            },
            "HTPASSWD_GREETING": {
              "type": "string",
              "title": "Basic-Auth-Begrüßung",
              "default": ""
            },
            "HTPASSWD_USER": {
              "type": "string",
              "title": "Basic-Auth-Benutzer",
              "description": "Besser ein vorhandenes Secret unter basicAuth.existingSecret verwenden.",
              "default": ""
            },
            "HTPASSWD_PWD": {
              "type": "string",
              "format": "password",
              "title": "Basic-Auth-Passwort",
              "description": "Besser ein vorhandenes Secret unter basicAuth.existingSecret verwenden.",
              "default": ""
            }
          }
        },
        "basicAuth": {
          "type": "object",
          "title": "Externes Basic-Auth-Secret",
          "description": "Optionales vorhandenes Secret mit HTPASSWD_USER und HTPASSWD_PWD.",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "title": "Secret-Name",
              "default": ""
            }
          }
        },
        "dependencyChecks": {
          "type": "object",
          "title": "Abhängigkeitsprüfungen",
          "description": "Wartezeit und Ressourcen der MariaDB-/Redis-Init-Container.",
          "additionalProperties": false,
          "properties": {
            "retryIntervalSeconds": {
              "type": "integer",
              "title": "Wiederholungsintervall in Sekunden",
              "default": 5,
              "minimum": 1
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "probes": {
          "type": "object",
          "title": "Health-Probes",
          "description": "Health-Endpunkt und Zeitwerte für Startup-, Readiness- und Liveness-Probes.",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "title": "Health-Pfad",
              "default": "/health",
              "pattern": "^/"
            },
            "hostHeader": {
              "type": "string",
              "title": "HTTP-Host-Header",
              "default": "localhost",
              "minLength": 1
            },
            "startup": {
              "$ref": "#/definitions/probeTiming"
            },
            "readiness": {
              "$ref": "#/definitions/probeTiming"
            },
            "liveness": {
              "$ref": "#/definitions/probeTiming"
            }
          }
        },
        "secret": {
          "type": "object",
          "title": "Drupal-Secret",
          "description": "Erzeugt und behält den Hash Salt oder verwendet ein vorhandenes Secret mit dem Schlüssel hash-salt.",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean",
              "title": "Secret erzeugen",
              "default": true
            },
            "existingSecret": {
              "type": "string",
              "title": "Vorhandenes Secret",
              "default": ""
            },
            "hashSalt": {
              "type": "string",
              "format": "password",
              "title": "Expliziter Hash Salt",
              "description": "Leer erzeugt bei der Erstinstallation einen zufälligen Wert.",
              "default": ""
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/drupalPersistence"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/definitions/containerSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        }
      }
    },
    "redis": {
      "type": "object",
      "title": "Redis",
      "description": "Optionaler Redis-Cache einschließlich Image, Zugangsdaten, Persistenz und Ressourcen.",
      "additionalProperties": false,
      "required": ["enabled", "image", "secret", "persistence"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Redis aktivieren",
          "default": true
        },
        "image": {
          "type": "object",
          "title": "Redis-Image",
          "description": "Offizielles Redis-Image oder kompatibler Ersatz.",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "title": "Image-Repository",
              "default": "docker.io/library/redis",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "title": "Image-Tag",
              "default": "8.2-alpine",
              "minLength": 1
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            },
            "autoUpdate": {
              "$ref": "#/definitions/autoUpdate"
            }
          }
        },
        "secret": {
          "type": "object",
          "title": "Redis-Secret",
          "description": "Erzeugt ein behaltenes Passwort oder verwendet ein vorhandenes Secret mit dem Schlüssel password.",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean",
              "title": "Secret erzeugen",
              "default": true
            },
            "existingSecret": {
              "type": "string",
              "title": "Vorhandenes Secret",
              "default": ""
            },
            "password": {
              "type": "string",
              "format": "password",
              "title": "Redis-Passwort",
              "description": "Leer erzeugt ein zufälliges Passwort. Explizite Werte müssen 16 bis 128 ASCII-Buchstaben oder Ziffern enthalten.",
              "default": "",
              "pattern": "^$|^[A-Za-z0-9]{16,128}$"
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/redisPersistence"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/definitions/containerSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        }
      }
    },
    "database": {
      "type": "object",
      "title": "MariaDB",
      "description": "Obligatorische Datenbank einschließlich Image, Zugangsdaten, Persistenz und Ressourcen.",
      "additionalProperties": false,
      "required": ["enabled", "image", "auth", "persistence"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "MariaDB aktivieren",
          "description": "Die unterstützten Drupal-Images benötigen MariaDB; false wird vom Chart abgelehnt.",
          "default": true
        },
        "config": {
          "type": "object",
          "title": "MariaDB-Konfiguration",
          "description": "Globale Einstellungen des Datenbankservers.",
          "additionalProperties": false,
          "properties": {
            "transactionIsolation": {
              "type": "string",
              "title": "Transaktionsisolation",
              "enum": ["READ-UNCOMMITTED", "READ-COMMITTED", "REPEATABLE-READ", "SERIALIZABLE"],
              "default": "READ-COMMITTED"
            }
          }
        },
        "image": {
          "type": "object",
          "title": "MariaDB-Image",
          "description": "Offizielles MariaDB-UBI-Image oder kompatibler Ersatz.",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "title": "Image-Repository",
              "default": "docker.io/library/mariadb",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "title": "Image-Tag",
              "default": "11.8-ubi9",
              "minLength": 1
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            },
            "autoUpdate": {
              "$ref": "#/definitions/autoUpdate"
            }
          }
        },
        "auth": {
          "type": "object",
          "title": "MariaDB-Zugangsdaten",
          "description": "Erzeugt ein behaltenes Secret oder verwendet ein vorhandenes Secret mit database, username, password und root-password.",
          "additionalProperties": false,
          "required": ["create", "database", "username"],
          "properties": {
            "create": {
              "type": "boolean",
              "title": "Secret erzeugen",
              "default": true
            },
            "existingSecret": {
              "type": "string",
              "title": "Vorhandenes Secret",
              "default": ""
            },
            "database": {
              "type": "string",
              "title": "Datenbankname",
              "default": "drupal",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_]+$"
            },
            "username": {
              "type": "string",
              "title": "Datenbankbenutzer",
              "default": "drupal",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_]+$"
            },
            "password": {
              "type": "string",
              "format": "password",
              "title": "Datenbankpasswort",
              "description": "Leer erzeugt bei der Erstinstallation ein zufälliges Passwort.",
              "default": ""
            },
            "rootPassword": {
              "type": "string",
              "format": "password",
              "title": "MariaDB-Root-Passwort",
              "description": "Leer erzeugt bei der Erstinstallation ein zufälliges Passwort.",
              "default": ""
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/databasePersistence"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/definitions/containerSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        }
      }
    }
  },
  "definitions": {
    "annotations": {
      "type": "object",
      "title": "Annotationen",
      "description": "Zusätzliche Schlüssel/Wert-Annotationen.",
      "default": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "stringMap": {
      "type": "object",
      "title": "Node Selector",
      "description": "Optionale Node-Label-Auswahl.",
      "default": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "freeObject": {
      "type": "object",
      "title": "Erweiterte Kubernetes-Konfiguration",
      "description": "Freies Kubernetes-Objekt; bei komplexen Einstellungen die YAML View verwenden.",
      "default": {},
      "additionalProperties": true
    },
    "tolerations": {
      "type": "array",
      "title": "Tolerations",
      "description": "Optionale Kubernetes-Tolerations; komplexe Werte lassen sich komfortabler in der YAML View pflegen.",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "pullPolicy": {
      "type": "string",
      "title": "Image Pull Policy",
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "autoUpdate": {
      "type": "object",
      "title": "OpenShift Image-Aktualisierung",
      "description": "ImageStream und Image-Change-Trigger für bewegliche Tags. Wird nur auf OpenShift ausgewertet.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Automatische Rollouts aktivieren",
          "default": true
        },
        "scheduledImport": {
          "type": "boolean",
          "title": "Image regelmäßig importieren",
          "default": true
        }
      }
    },
    "yesNo": {
      "type": "string",
      "title": "Beim Containerstart ausführen",
      "enum": ["no", "yes"],
      "default": "no"
    },
    "probeTiming": {
      "type": "object",
      "title": "Probe-Zeitwerte",
      "description": "Intervall, Timeout und Anzahl zulässiger Fehlschläge.",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "title": "Intervall in Sekunden",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "title": "Timeout in Sekunden",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "title": "Fehlerschwelle",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "title": "CPU und Arbeitsspeicher",
      "description": "Kubernetes Resource Requests und Limits als Mengenangaben, zum Beispiel 100m oder 256Mi.",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "title": "Requests",
          "additionalProperties": false,
          "properties": {
            "cpu": {
