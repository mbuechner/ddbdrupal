{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "drupal",
    "redis",
    "database",
    "verticalPodAutoscaler"
  ],
  "properties": {
    "platform": {
      "type": "object",
      "title": "WICHTIG: Zielplattform",
      "description": "Waehlt OpenShift Route und ImageStreams oder ein Kubernetes Ingress. Ein values-*.yaml-Profil wird nur mit Helm -f geladen; in der Form View die darunter dokumentierten Profilwerte verwenden.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Plattform",
          "description": "Fuer die Installation aus dem OpenShift Developer Catalog openshift verwenden.",
          "enum": ["openshift", "kubernetes"],
          "default": "openshift"
        }
      }
    },
    "drupal": {
      "type": "object",
      "title": "WICHTIG: Website-Profil und Drupal",
      "description": "Profilwerte: ddbgo = Release ddbgo, Host go.deutsche-digitale-bibliothek.de, Image ghcr.io/mbuechner/ddbgo:tagged; ddbgo-t = Release ddbgo-t, Host go-t.deutsche-digitale-bibliothek.de, gleiches Image mit Tag test; ddbpro = Release ddbpro, Host pro.deutsche-digitale-bibliothek.de, Image ghcr.io/deutsche-digitale-bibliothek/ddbpro:tagged; ddbpro-t = Release ddbpro-t, Host pro-t.deutsche-digitale-bibliothek.de, gleiches Image mit Tag test.",
      "additionalProperties": false,
      "required": ["externalHost", "image", "persistence"],
      "properties": {
        "externalHost": {
          "type": "string",
          "title": "WICHTIG: Oeffentlicher DNS-Hostname",
          "description": "Host fuer Route oder Ingress und Drupals Trusted-Host-Regel. DDBgo: go.deutsche-digitale-bibliothek.de; DDBgo-Test: go-t.deutsche-digitale-bibliothek.de; DDBpro: pro.deutsche-digitale-bibliothek.de; DDBpro-Test: pro-t.deutsche-digitale-bibliothek.de.",
          "default": "change-me.example.invalid",
          "minLength": 4,
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "image": {
          "type": "object",
          "title": "WICHTIG: Drupal-Image und Profil",
          "description": "DDBgo und ddbgo-t verwenden ghcr.io/mbuechner/ddbgo. DDBpro und ddbpro-t verwenden ghcr.io/deutsche-digitale-bibliothek/ddbpro. Produktion nutzt tagged, Test nutzt test.",
          "additionalProperties": false,
          "required": ["preset", "repository", "tag", "pullPolicy"],
          "properties": {
            "preset": {
              "type": "string",
              "title": "Drupal-Image-Profil",
              "description": "Waehlt eine gepflegte DDBgo-/DDBpro-Kombination. custom verwendet die darunter eingetragenen Werte fuer Repository und Tag.",
              "enum": ["custom", "ddbgo-production", "ddbgo-test", "ddbpro-production", "ddbpro-test"],
              "default": "custom"
            },
            "repository": {
              "type": "string",
              "title": "Image-Repository",
              "description": "Wird nur mit Profil custom verwendet. DDBgo: ghcr.io/mbuechner/ddbgo; DDBpro: ghcr.io/deutsche-digitale-bibliothek/ddbpro.",
              "default": "ghcr.io/mbuechner/ddbgo",
              "minLength": 1,
              "pattern": "^[^\\s]+$"
            },
            "tag": {
              "type": "string",
              "title": "Image-Tag",
              "description": "Wird nur mit Profil custom verwendet. Produktion: tagged; Test: test.",
              "default": "tagged",
              "minLength": 1,
              "pattern": "^[^\\s]+$"
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            },
            "autoUpdate": {
              "$ref": "#/definitions/autoUpdate"
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/drupalPersistence"
        },
        "replicaCount": {
          "type": "integer",
          "title": "Optional: Drupal-Replikate",
          "description": "Mehr als eine Replik erfordert ein ReadWriteMany-faehiges Drupal-Volume.",
          "default": 1,
          "minimum": 1
        },
        "service": {
          "type": "object",
          "title": "Optional: Drupal-Service",
          "description": "Interner HTTP-Service fuer Route oder Ingress.",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "title": "Service-Port",
              "default": 8080,
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "route": {
          "type": "object",
          "title": "Optional: OpenShift Route",
          "description": "Wird nur auf OpenShift ausgewertet. TLS endet gemaess Betriebsmodell vor der Route.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Route erzeugen",
              "default": true
            },
            "annotations": {
              "$ref": "#/definitions/annotations"
            }
          }
        },
        "ingress": {
          "type": "object",
          "title": "Optional: Kubernetes Ingress",
          "description": "Wird nur mit platform.type=kubernetes ausgewertet.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Ingress erzeugen",
              "default": true
            },
            "className": {
              "type": "string",
              "title": "IngressClass",
              "default": ""
            },
            "annotations": {
              "$ref": "#/definitions/annotations"
            },
            "path": {
              "type": "string",
              "title": "Ingress-Pfad",
              "default": "/",
              "pattern": "^/"
            },
            "pathType": {
              "type": "string",
              "title": "Ingress-Pfadtyp",
              "enum": ["Exact", "Prefix", "ImplementationSpecific"],
              "default": "Prefix"
            }
          }
        },
        "config": {
          "type": "object",
          "title": "Optional: Drupal-Konfiguration",
          "description": "Pfade, Trusted Hosts und lokaler Drush-Kontext des kompatiblen Drupal-Images.",
          "additionalProperties": false,
          "properties": {
            "webRoot": {
              "type": "string",
              "title": "Drupal-Webroot",
              "default": "/var/www/html/web",
              "pattern": "^/"
            },
            "updateFreeAccess": {
              "type": "boolean",
              "title": "Freien Zugriff auf update.php erlauben",
              "default": false
            },
            "filePublicPath": {
              "type": "string",
              "title": "Oeffentlicher Dateipfad",
              "description": "Relativ zum Drupal-Webroot und ohne .- oder ..-Segmente.",
              "default": "sites/default/files",
              "minLength": 1,
              "pattern": "^[^/].*$"
            },
            "filePrivatePath": {
              "type": "string",
              "title": "Privater Dateipfad",
              "default": "/var/www/html/private",
              "pattern": "^/"
            },
            "tempPath": {
              "type": "string",
              "title": "Temporaerer Pfad",
              "default": "/tmp",
              "pattern": "^/"
            },
            "trustedHosts": {
              "type": "object",
              "title": "Zusaetzliche Trusted Hosts",
              "description": "Literale Hostnamen; das Chart maskiert sie automatisch fuer Drupals regulaere Ausdruecke.",
              "additionalProperties": false,
              "properties": {
                "allowLocalhost": {
                  "type": "boolean",
                  "title": "localhost erlauben",
                  "default": true
                },
                "additionalHosts": {
                  "type": "array",
                  "title": "Weitere Hostnamen",
                  "default": [],
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "drushOptionsUri": {
              "type": "string",
              "title": "Lokale Drush-URI",
              "default": "http://localhost:8080",
              "pattern": "^https?://"
            }
          }
        },
        "env": {
          "type": "object",
          "title": "Optional: Drupal-Startaktionen und Basic Auth",
          "description": "Steuert zustandsaendernde Drush-Aktionen beim Containerstart sowie optionale HTTP-Basic-Auth-Werte.",
          "additionalProperties": false,
          "properties": {
            "UPDATEDB_ON_STARTUP": {
              "$ref": "#/definitions/yesNo"
            },
            "CONFIG_IMPORT_ON_STARTUP": {
              "$ref": "#/definitions/yesNo"
            },
            "CACHEREBUILD_ON_STARTUP": {
              "$ref": "#/definitions/yesNo"
            },
            "HTPASSWD_GREETING": {
              "type": "string",
              "title": "Basic-Auth-Begruessung",
              "default": ""
            },
            "HTPASSWD_USER": {
              "type": "string",
              "title": "Basic-Auth-Benutzer",
              "description": "Besser ein vorhandenes Secret unter basicAuth.existingSecret verwenden.",
              "default": ""
            },
            "HTPASSWD_PWD": {
              "type": "string",
              "format": "password",
              "title": "Basic-Auth-Passwort",
              "description": "Besser ein vorhandenes Secret unter basicAuth.existingSecret verwenden.",
              "default": ""
            }
          }
        },
        "basicAuth": {
          "type": "object",
          "title": "Optional: Externes Basic-Auth-Secret",
          "description": "Optionales vorhandenes Secret mit HTPASSWD_USER und HTPASSWD_PWD.",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "title": "Secret-Name",
              "default": ""
            }
          }
        },
        "dependencyChecks": {
          "type": "object",
          "title": "Erweitert: Abhaengigkeitspruefungen",
          "description": "Wartezeit und Ressourcen der MariaDB-/Redis-Init-Container.",
          "additionalProperties": false,
          "properties": {
            "retryIntervalSeconds": {
              "type": "integer",
              "title": "Wiederholungsintervall in Sekunden",
              "default": 5,
              "minimum": 1
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "probes": {
          "type": "object",
          "title": "Erweitert: Health-Probes",
          "description": "Health-Endpunkt und Zeitwerte fuer Startup-, Readiness- und Liveness-Probes.",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "title": "Health-Pfad",
              "default": "/health",
              "pattern": "^/"
            },
            "hostHeader": {
              "type": "string",
              "title": "HTTP-Host-Header",
              "default": "localhost",
              "minLength": 1
            },
            "startup": {
              "$ref": "#/definitions/probeTiming"
            },
            "readiness": {
              "$ref": "#/definitions/probeTiming"
            },
            "liveness": {
              "$ref": "#/definitions/probeTiming"
            }
          }
        },
        "secret": {
          "type": "object",
          "title": "Optional: Drupal-Secret",
          "description": "Erzeugt und behaelt den Hash Salt oder verwendet ein vorhandenes Secret mit dem Schluessel hash-salt.",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean",
              "title": "Secret erzeugen",
              "default": true
            },
            "existingSecret": {
              "type": "string",
              "title": "Vorhandenes Secret",
              "default": ""
            },
            "hashSalt": {
              "type": "string",
              "format": "password",
              "title": "Expliziter Hash Salt",
              "description": "Leer erzeugt bei der Erstinstallation einen zufaelligen Wert.",
              "default": ""
            }
          }
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/definitions/containerSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        }
      }
    },
    "database": {
      "type": "object",
      "title": "WICHTIG: MariaDB-Profil",
      "description": "Datenbank und Benutzer werden aus Release und Preset abgeleitet. Leere Passwoerter werden bei der Erstinstallation sicher erzeugt.",
      "additionalProperties": false,
      "required": ["image", "auth", "persistence"],
      "properties": {
        "auth": {
          "type": "object",
          "title": "WICHTIG: Datenbankzugang",
          "description": "Datenbank und Benutzer werden automatisch abgeleitet. Passwoerter leer lassen, um sie sicher zu erzeugen, oder ein vorhandenes Secret angeben.",
          "additionalProperties": false,
          "required": ["create"],
          "properties": {
            "create": {
              "type": "boolean",
              "title": "Secret erzeugen",
              "default": true
            },
            "existingSecret": {
              "type": "string",
              "title": "Vorhandenes Secret",
              "default": ""
            },
            "password": {
              "type": "string",
              "format": "password",
              "title": "Datenbankpasswort",
              "description": "Leer erzeugt bei der Erstinstallation ein zufaelliges Passwort.",
              "default": ""
            },
            "rootPassword": {
              "type": "string",
              "format": "password",
              "title": "MariaDB-Root-Passwort",
              "description": "Leer erzeugt bei der Erstinstallation ein zufaelliges Passwort.",
              "default": ""
            }
          }
        },
        "config": {
          "type": "object",
          "title": "Optional: MariaDB-Konfiguration",
          "description": "Globale Einstellungen des Datenbankservers.",
          "additionalProperties": false,
          "properties": {
            "transactionIsolation": {
              "type": "string",
              "title": "Transaktionsisolation",
              "enum": ["READ-UNCOMMITTED", "READ-COMMITTED", "REPEATABLE-READ", "SERIALIZABLE"],
              "default": "READ-COMMITTED"
            }
          }
        },
        "image": {
          "type": "object",
          "title": "Optional: MariaDB-Image",
          "description": "Offizielles MariaDB-UBI-Image oder kompatibler Ersatz.",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "title": "Image-Repository",
              "default": "docker.io/library/mariadb",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "title": "Image-Tag",
              "default": "11.8-ubi9",
              "minLength": 1
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            },
            "autoUpdate": {
              "$ref": "#/definitions/autoUpdate"
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/databasePersistence"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/definitions/containerSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        }
      }
    },
    "redis": {
      "type": "object",
      "title": "Optional: Redis-Cache",
      "description": "Optionaler Redis-Cache einschliesslich Image, Zugangsdaten, Persistenz und Ressourcen.",
      "additionalProperties": false,
      "required": ["enabled", "image", "secret", "persistence"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Redis aktivieren",
          "default": true
        },
        "image": {
          "type": "object",
          "title": "Optional: Redis-Image",
          "description": "Offizielles Redis-Image oder kompatibler Ersatz.",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "title": "Image-Repository",
              "default": "docker.io/library/redis",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "title": "Image-Tag",
              "default": "8.2-alpine",
              "minLength": 1
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            },
            "autoUpdate": {
              "$ref": "#/definitions/autoUpdate"
            }
          }
        },
        "secret": {
          "type": "object",
          "title": "Optional: Redis-Secret",
          "description": "Erzeugt ein behaltenes Passwort oder verwendet ein vorhandenes Secret mit dem Schluessel password.",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean",
              "title": "Secret erzeugen",
              "default": true
            },
            "existingSecret": {
              "type": "string",
              "title": "Vorhandenes Secret",
              "default": ""
            },
            "password": {
              "type": "string",
              "format": "password",
              "title": "Redis-Passwort",
              "description": "Leer erzeugt ein zufaelliges Passwort. Explizite Werte muessen 16 bis 128 ASCII-Buchstaben oder Ziffern enthalten.",
              "default": "",
              "pattern": "^$|^[A-Za-z0-9]{16,128}$"
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/redisPersistence"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/definitions/containerSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        }
      }
    },
    "naming": {
      "type": "object",
      "title": "Optional: Release-Namen absichern",
      "description": "Schutz vor Installationen unter einem falschen Release- oder Namespace-Namen.",
      "additionalProperties": false,
      "properties": {
        "enforceReleaseNamespaceMatch": {
          "type": "boolean",
          "title": "Release und Namespace muessen uebereinstimmen",
          "default": false
        },
        "allowedReleaseNames": {
          "type": "array",
          "title": "Erlaubte Release-Namen",
          "description": "Leer erlaubt beliebige Namen. Website-Profile begrenzen die Auswahl auf ihren vorgesehenen Release-Namen.",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 53
          }
        }
      }
    },
    "verticalPodAutoscaler": {
      "type": "object",
      "title": "Optional: Vertical Pod Autoscaler",
      "description": "Nur aktivieren, wenn VPA-Operator und CRD installiert sind. Der Modus Off sammelt nur Empfehlungen.",
      "additionalProperties": false,
      "required": ["enabled", "updateMode"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "VPA-Ressourcen erzeugen",
          "default": false
        },
        "updateMode": {
          "type": "string",
          "title": "Update-Modus",
          "enum": ["Off", "Initial", "Recreate", "InPlaceOrRecreate", "InPlace", "Auto"],
          "default": "Off"
        },
        "controlledValues": {
          "type": "string",
          "title": "Gesteuerte Werte",
          "enum": ["RequestsAndLimits", "RequestsOnly"],
          "default": "RequestsAndLimits"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "title": "Optional: Registry-Zugangsdaten",
      "description": "Bereits vorhandene Image-Pull-Secrets fuer alle Pods.",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "title": "Secret-Name",
            "minLength": 1
          }
        }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "title": "Erweitert: Service Accounts",
      "description": "Erzeugt getrennte Service Accounts fuer Drupal, Redis und MariaDB oder verwendet vorhandene Namen.",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "title": "Service Accounts erzeugen",
          "default": true
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "drupalName": {
          "type": "string",
          "title": "Vorhandener Drupal Service Account",
          "default": ""
        },
        "redisName": {
          "type": "string",
          "title": "Vorhandener Redis Service Account",
          "default": ""
        },
        "databaseName": {
          "type": "string",
          "title": "Vorhandener MariaDB Service Account",
          "default": ""
        }
      }
    },
    "commonAnnotations": {
      "$ref": "#/definitions/annotations"
    }
  },
  "definitions": {
    "annotations": {
      "type": "object",
      "title": "Optional: Annotationen",
      "description": "Zusaetzliche Schluessel/Wert-Annotationen.",
      "default": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "stringMap": {
      "type": "object",
      "title": "Erweitert: Node Selector",
      "description": "Optionale Node-Label-Auswahl.",
      "default": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "freeObject": {
      "type": "object",
      "title": "Erweitert: Kubernetes-Konfiguration",
      "description": "Freies Kubernetes-Objekt; bei komplexen Einstellungen die YAML View verwenden.",
      "default": {},
      "additionalProperties": true
    },
    "tolerations": {
      "type": "array",
      "title": "Erweitert: Tolerations",
      "description": "Optionale Kubernetes-Tolerations; komplexe Werte lassen sich komfortabler in der YAML View pflegen.",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "pullPolicy": {
      "type": "string",
      "title": "Image Pull Policy",
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "autoUpdate": {
      "type": "object",
      "title": "Optional: OpenShift Image-Aktualisierung",
      "description": "ImageStream und Image-Change-Trigger fuer bewegliche Tags. Wird nur auf OpenShift ausgewertet.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Automatische Rollouts aktivieren",
          "default": true
        },
        "scheduledImport": {
          "type": "boolean",
          "title": "Image regelmaessig importieren",
          "default": true
        }
      }
    },
    "yesNo": {
      "type": "string",
      "title": "Beim Containerstart ausfuehren",
      "enum": ["no", "yes"],
      "default": "no"
    },
    "probeTiming": {
      "type": "object",
      "title": "Erweitert: Probe-Zeitwerte",
      "description": "Intervall, Timeout und Anzahl zulaessiger Fehlschlaege.",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "title": "Intervall in Sekunden",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "title": "Timeout in Sekunden",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "title": "Fehlerschwelle",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "title": "Optional: CPU und Arbeitsspeicher",
      "description": "Kubernetes Resource Requests und Limits als Mengenangaben, zum Beispiel 100m oder 256Mi.",
