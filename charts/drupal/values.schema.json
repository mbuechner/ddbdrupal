{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deploymentProfile",
    "platform",
    "drupal"
  ],
  "properties": {
    "deploymentProfile": {
      "type": "string",
      "title": "01 Deployment-Profil",
      "description": "Waehlt Domain, Drupal-Image und erforderlichen Release-Namen gemeinsam. custom verwendet die frei konfigurierbaren Drupal-Werte.",
      "enum": ["custom", "ddbgo-production", "ddbgo-test", "ddbpro-production", "ddbpro-test"],
      "default": "custom"
    },
    "platform": {
      "type": "object",
      "title": "02 Zielplattform",
      "description": "Im OpenShift Catalog openshift beibehalten. kubernetes erzeugt ein Ingress und benoetigt zusaetzlich values-kubernetes.yaml.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "title": "Plattform",
          "description": "Fuer die Installation aus dem OpenShift Developer Catalog openshift verwenden.",
          "enum": ["openshift", "kubernetes"],
          "default": "openshift"
        }
      }
    },
    "drupal": {
      "type": "object",
      "title": "03 Drupal-Anwendung",
      "description": "Anwendungseinstellungen. Felder mit 'custom' werden bei einem gepflegten Profil ignoriert.",
      "additionalProperties": false,
      "properties": {
        "externalHost": {
          "type": "string",
          "title": "01 custom: Oeffentlicher Host",
          "description": "Nur mit deploymentProfile=custom: DNS-Hostname fuer Route oder Ingress und Drupals Trusted-Host-Regel.",
          "default": "change-me.example.invalid",
          "minLength": 4,
          "maxLength": 253,
          "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "image": {
          "type": "object",
          "title": "02 custom: Drupal-Image",
          "description": "Nur mit deploymentProfile=custom. Gepflegte Profile setzen Repository und Tag automatisch.",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "title": "Image-Repository",
              "description": "Nur mit deploymentProfile=custom verwendet.",
              "default": "ghcr.io/mbuechner/ddbgo",
              "minLength": 1,
              "pattern": "^[^\\s]+$"
            },
            "tag": {
              "type": "string",
              "title": "Image-Tag",
              "description": "Nur mit deploymentProfile=custom verwendet.",
              "default": "tagged",
              "minLength": 1,
              "pattern": "^[^\\s]+$"
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            },
            "autoUpdate": {
              "$ref": "#/definitions/autoUpdate"
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/drupalPersistence"
        },
        "replicaCount": {
          "type": "integer",
          "title": "04 Drupal-Replikate",
          "description": "Mehr als eine Replik erfordert ein ReadWriteMany-faehiges Drupal-Volume.",
          "default": 1,
          "minimum": 1
        },
        "service": {
          "type": "object",
          "title": "05 Service",
          "description": "Interner HTTP-Service fuer Route oder Ingress.",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "title": "Service-Port",
              "default": 8080,
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "route": {
          "type": "object",
          "title": "06 OpenShift Route",
          "description": "Wird nur auf OpenShift ausgewertet. TLS endet gemaess Betriebsmodell vor der Route.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Route erzeugen",
              "default": true
            },
            "annotations": {
              "$ref": "#/definitions/annotations"
            }
          }
        },
        "ingress": {
          "type": "object",
          "title": "07 Kubernetes Ingress",
          "description": "Wird nur mit platform.type=kubernetes ausgewertet.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Ingress erzeugen",
              "default": true
            },
            "className": {
              "type": "string",
              "title": "IngressClass",
              "default": ""
            },
            "annotations": {
              "$ref": "#/definitions/annotations"
            },
            "path": {
              "type": "string",
              "title": "Ingress-Pfad",
              "default": "/",
              "pattern": "^/"
            },
            "pathType": {
              "type": "string",
              "title": "Ingress-Pfadtyp",
              "enum": ["Exact", "Prefix", "ImplementationSpecific"],
              "default": "Prefix"
            }
          }
        },
        "config": {
          "type": "object",
          "title": "08 Trusted Hosts",
          "description": "Erzeugt TRUSTED_HOST_PATTERNS sicher aus literalen Hostnamen.",
          "additionalProperties": false,
          "properties": {
            "trustedHosts": {
              "type": "object",
              "title": "Host-Regeln",
              "description": "Keine regulaeren Ausdruecke eingeben; das Chart maskiert die Hostnamen automatisch.",
              "additionalProperties": false,
              "properties": {
                "allowLocalhost": {
                  "type": "boolean",
                  "title": "localhost und 127.0.0.1 erlauben",
                  "default": true
                },
                "additionalHosts": {
                  "type": "array",
                  "title": "Zusaetzliche Hostnamen",
                  "default": [],
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "startup": {
          "type": "object",
          "title": "09 Startaktionen",
          "description": "Optional bei jedem Containerstart auszufuehrende Drush-Aktionen.",
          "additionalProperties": false,
          "properties": {
            "updateDatabase": {
              "type": "boolean",
              "title": "Datenbank aktualisieren",
              "description": "Fuehrt drush updatedb bei jedem Containerstart aus.",
              "default": false
            },
            "importConfig": {
              "type": "boolean",
              "title": "Drupal-Konfiguration importieren",
              "description": "Fuehrt drush config:import bei jedem Containerstart aus.",
              "default": false
            },
            "rebuildCache": {
              "type": "boolean",
              "title": "Drupal-Cache neu aufbauen",
              "description": "Fuehrt drush cache:rebuild bei jedem Containerstart aus.",
              "default": false
            }
          }
        },
        "basicAuth": {
          "type": "object",
          "title": "10 HTTP Basic Auth",
          "description": "Aktiv, sobald Benutzer und Passwort gemeinsam gesetzt sind. Das Chart verwaltet das Secret.",
          "additionalProperties": false,
          "properties": {
            "greeting": {
              "type": "string",
              "title": "Begruessung",
              "default": ""
            },
            "username": {
              "type": "string",
              "title": "Benutzer",
              "description": "Gemeinsam mit Passwort setzen.",
              "default": ""
            },
            "password": {
              "type": "string",
              "format": "password",
              "title": "Passwort",
              "description": "Gemeinsam mit Benutzer setzen. Das Chart speichert den Wert in einem Secret.",
              "default": ""
            }
          }
        },
        "smtp": {
          "type": "object",
          "title": "11 SMTP",
          "description": "Optionaler externer Mailversand. Bei deaktiviertem SMTP bleiben die weiteren Werte ohne Wirkung.",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "title": "Mailversand aktivieren", "default": false },
            "host": { "type": "string", "title": "Primaerer Server", "default": "smtp.example.org", "minLength": 1 },
            "hostBackup": { "type": "string", "title": "Ersatzserver", "default": "smtp-backup.example.org" },
            "port": { "type": "integer", "title": "Port", "default": 587, "minimum": 1, "maximum": 65535 },
            "protocol": { "type": "string", "title": "Verschluesselung", "enum": ["", "ssl", "tls"], "default": "tls" },
            "autoTls": { "type": "boolean", "title": "Auto-TLS", "default": true },
            "timeout": { "type": "integer", "title": "Timeout in Sekunden", "default": 30, "minimum": 1 },
            "username": { "type": "string", "title": "Benutzer", "default": "noreply@example.org" },
            "password": { "type": "string", "format": "password", "title": "Passwort", "description": "Das Chart speichert den Wert in einem Secret.", "default": "" },
            "from": { "type": "string", "format": "email", "title": "Absenderadresse", "default": "noreply@example.org" },
            "fromName": { "type": "string", "title": "Absendername", "default": "DDBpro" },
            "allowHtml": { "type": "boolean", "title": "HTML-E-Mails erlauben", "default": true },
            "testAddress": { "type": "string", "format": "email", "title": "Testadresse", "default": "developer@example.org" },
            "rerouteAddress": { "type": "string", "title": "Alle E-Mails umleiten an", "description": "Nur fuer Testsysteme. Leer lassen, um normal an die eigentlichen Empfaenger zu senden.", "default": "" },
            "debugging": { "type": "boolean", "title": "Debugging", "default": false },
            "debugLevel": { "type": "integer", "title": "Debug-Level", "default": 1, "minimum": 0 },
            "keepalive": { "type": "boolean", "title": "Verbindung offen halten", "default": false }
          }
        },
        "dependencyChecks": {
          "type": "object",
          "title": "12 Erweitert: Abhaengigkeitspruefungen",
          "description": "Wartezeit und Ressourcen der MariaDB-/Redis-Init-Container.",
          "additionalProperties": false,
          "properties": {
            "retryIntervalSeconds": {
              "type": "integer",
              "title": "Wiederholungsintervall in Sekunden",
              "default": 5,
              "minimum": 1
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "probes": {
          "type": "object",
          "title": "13 Erweitert: Health-Probes",
          "description": "Health-Endpunkt und Zeitwerte fuer Startup-, Readiness- und Liveness-Probes.",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "title": "Health-Pfad",
              "default": "/health",
              "pattern": "^/"
            },
            "startup": {
              "$ref": "#/definitions/probeTiming"
            },
            "readiness": {
              "$ref": "#/definitions/probeTiming"
            },
            "liveness": {
              "$ref": "#/definitions/probeTiming"
            }
          }
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/definitions/containerSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        }
      }
    },
    "database": {
      "type": "object",
      "title": "04 Erweitert: MariaDB",
      "description": "Datenbank, Benutzer und Passwoerter werden vom Chart automatisch verwaltet.",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "object",
          "title": "Serverkonfiguration",
          "description": "Globale Einstellungen des Datenbankservers.",
          "additionalProperties": false,
          "properties": {
            "transactionIsolation": {
              "type": "string",
              "title": "Transaktionsisolation",
              "enum": ["READ-UNCOMMITTED", "READ-COMMITTED", "REPEATABLE-READ", "SERIALIZABLE"],
              "default": "READ-COMMITTED"
            }
          }
        },
        "image": {
          "type": "object",
          "title": "Container-Image",
          "description": "Offizielles MariaDB-UBI-Image oder kompatibler Ersatz.",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "title": "Image-Repository",
              "default": "docker.io/library/mariadb",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "title": "Image-Tag",
              "default": "11.8-ubi9",
              "minLength": 1
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            },
            "autoUpdate": {
              "$ref": "#/definitions/autoUpdate"
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/databasePersistence"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/definitions/containerSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        }
      }
    },
    "redis": {
      "type": "object",
      "title": "05 Erweitert: Redis",
      "description": "Redis ist fester Bestandteil des Charts; hier stehen nur technische Betriebswerte.",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "title": "Container-Image",
          "description": "Offizielles Redis-Image oder kompatibler Ersatz.",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "title": "Image-Repository",
              "default": "docker.io/library/redis",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "title": "Image-Tag",
              "default": "8.2-alpine",
              "minLength": 1
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            },
            "autoUpdate": {
              "$ref": "#/definitions/autoUpdate"
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/redisPersistence"
        },
        "podAnnotations": {
          "$ref": "#/definitions/annotations"
        },
        "podSecurityContext": {
          "$ref": "#/definitions/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/definitions/containerSecurityContext"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/tolerations"
        },
        "affinity": {
          "$ref": "#/definitions/freeObject"
        }
      }
    },
    "verticalPodAutoscaler": {
      "type": "object",
      "title": "06 Erweitert: Vertical Pod Autoscaler",
      "description": "Nur aktivieren, wenn VPA-Operator und CRD installiert sind. Der Modus Off sammelt nur Empfehlungen.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "VPA-Ressourcen erzeugen",
          "default": true
        },
        "updateMode": {
          "type": "string",
          "title": "Update-Modus",
          "enum": ["Off", "Initial", "Recreate", "InPlaceOrRecreate", "InPlace", "Auto"],
          "default": "Off"
        },
        "controlledValues": {
          "type": "string",
          "title": "Gesteuerte Werte",
          "enum": ["RequestsAndLimits", "RequestsOnly"],
          "default": "RequestsAndLimits"
        }
      }
    },
    "storagePreparationResources": {
      "title": "07 Erweitert: Storage-Init-Container",
      "description": "Kleine explizite Requests und Limits fuer die kurzlebigen prepare-*-storage Init-Container; verhindert hohe, durch Namespace-LimitRanges injizierte Standardwerte.",
      "$ref": "#/definitions/resources"
    },
    "serviceAccounts": {
      "type": "object",
      "title": "08 Erweitert: Service Accounts",
      "description": "Erzeugt getrennte Service Accounts fuer Drupal, Redis und MariaDB oder verwendet vorhandene Namen.",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "title": "Service Accounts erzeugen",
          "default": true
        },
        "annotations": {
          "$ref": "#/definitions/annotations"
        },
        "drupalName": {
          "type": "string",
          "title": "Vorhandener Drupal Service Account",
          "default": ""
        },
        "redisName": {
          "type": "string",
          "title": "Vorhandener Redis Service Account",
          "default": ""
        },
        "databaseName": {
          "type": "string",
          "title": "Vorhandener MariaDB Service Account",
          "default": ""
        }
      }
    },
    "commonAnnotations": {
      "title": "09 Erweitert: Gemeinsame Annotationen",
      "$ref": "#/definitions/annotations"
    }
  },
  "definitions": {
    "annotations": {
      "type": "object",
      "title": "Optional: Annotationen",
      "description": "Zusaetzliche Schluessel/Wert-Annotationen.",
      "default": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "stringMap": {
      "type": "object",
      "title": "Erweitert: Node Selector",
      "description": "Optionale Node-Label-Auswahl.",
      "default": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "freeObject": {
      "type": "object",
      "title": "Erweitert: Kubernetes-Konfiguration",
      "description": "Freies Kubernetes-Objekt; bei komplexen Einstellungen die YAML View verwenden.",
      "default": {},
      "additionalProperties": true
    },
    "tolerations": {
      "type": "array",
      "title": "Erweitert: Tolerations",
      "description": "Optionale Kubernetes-Tolerations; komplexe Werte lassen sich komfortabler in der YAML View pflegen.",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "pullPolicy": {
      "type": "string",
      "title": "Image Pull Policy",
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "autoUpdate": {
      "type": "object",
      "title": "Optional: OpenShift Image-Aktualisierung",
      "description": "ImageStream und Image-Change-Trigger fuer bewegliche Tags. Wird nur auf OpenShift ausgewertet.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Automatische Rollouts aktivieren",
          "default": true
        },
        "scheduledImport": {
          "type": "boolean",
          "title": "Image regelmaessig importieren",
          "default": true
        }
      }
    },
    "probeTiming": {
      "type": "object",
      "title": "Erweitert: Probe-Zeitwerte",
      "description": "Intervall, Timeout und Anzahl zulaessiger Fehlschlaege.",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "title": "Intervall in Sekunden",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "title": "Timeout in Sekunden",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "title": "Fehlerschwelle",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "title": "Optional: CPU und Arbeitsspeicher",
      "description": "Kubernetes Resource Requests und Limits als Mengenangaben, zum Beispiel 100m oder 256Mi.",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "title": "Requests",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "title": "CPU Request",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "title": "Memory Request",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "title": "Limits",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "title": "CPU Limit",
              "minLength": 1
            },
            "memory": {
              "type": "string",
              "title": "Memory Limit",
              "minLength": 1
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "title": "Erweitert: Pod Security Context",
      "description": "OpenShift weist UID/GID normalerweise dynamisch zu. Feste IDs nur fuer passende Images und Kubernetes verwenden.",
      "additionalProperties": true,
      "properties": {
        "runAsNonRoot": {
          "type": "boolean",
          "title": "Als Non-Root ausfuehren",
          "default": true
        },
        "runAsUser": {
          "type": "integer",
          "title": "Numerische UID",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "title": "Numerische primaere GID",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "title": "Volume-GID",
          "minimum": 1
        },
        "seccompProfile": {
          "type": "object",
          "title": "Seccomp-Profil",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "title": "Profiltyp",
              "enum": ["RuntimeDefault", "Localhost", "Unconfined"],
              "default": "RuntimeDefault"
            },
            "localhostProfile": {
              "type": "string",
              "title": "Lokales Profil"
            }
          }
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "title": "Erweitert: Container Security Context",
      "description": "Restriktive Container-Sicherheitseinstellungen; Aenderungen koennen die OpenShift-SCC-Kompatibilitaet beeintraechtigen.",
      "additionalProperties": true,
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean",
          "title": "Privilege Escalation erlauben",
          "default": false
        },
        "runAsNonRoot": {
          "type": "boolean",
          "title": "Als Non-Root ausfuehren",
          "default": true
        },
        "readOnlyRootFilesystem": {
          "type": "boolean",
          "title": "Root-Dateisystem schreibgeschuetzt"
        },
        "capabilities": {
          "type": "object",
          "title": "Linux-Capabilities",
          "additionalProperties": false,
          "properties": {
            "drop": {
              "type": "array",
              "title": "Zu entfernende Capabilities",
              "default": ["ALL"],
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "add": {
              "type": "array",
              "title": "Zusaetzliche Capabilities",
              "default": [],
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "drupalPersistence": {
      "type": "object",
      "title": "03 Drupal-Speicher",
      "description": "OpenShift-Default: ReadWriteMany. values-kubernetes.yaml verwendet fuer eine Einzelreplik ReadWriteOnce.",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "title": "PVC erzeugen",
          "default": true
        },
        "retain": {
          "type": "boolean",
          "title": "PVC bei Deinstallation behalten",
          "default": true
        },
        "existingClaim": {
          "type": "string",
          "title": "Vorhandener PVC",
          "default": ""
        },
        "accessModes": {
          "type": "array",
          "title": "Zugriffsmodi",
          "default": ["ReadWriteMany"],
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
          }
        },
        "size": {
          "type": "string",
          "title": "Speichergroesse",
          "description": "Gilt nur bei der ersten Anlage. Ein vorhandener PVC wird unveraendert weiterverwendet.",
